# Copy to .env and fill in. .env is never committed.
# The family's own Supabase project (not SOAR's). Added in phase one.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# The journal's Google Doc sync (README, "Journal and Google Docs"). Not secret: they ship in the app,
# and Google accepts them only from hicks.web.app and localhost. Leave empty to keep the sync off.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_API_KEY=
VITE_GOOGLE_APP_ID=
